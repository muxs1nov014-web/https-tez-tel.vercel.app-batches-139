# PostgreSQL
POSTGRES_USER=telefon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=telefon
DATABASE_URL=postgresql+asyncpg://telefon:change-me@db:5432/telefon

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Telegram bot
TELEGRAM_BOT_TOKEN=
# Groups the bot reads silently (comma-separated chat IDs, e.g. -1001234567890); empty = every group it is added to.
# The bot never posts to groups. It needs BotFather /setprivacy -> Disable (or group admin rights) to see messages.
TELEGRAM_GROUP_IDS=
# Daily nasiya workbooks (SPEC §18): groups whose .xlsx files become nasiya reports, e.g. -1003839931967. Empty = every stored group.
NASIYA_CHAT_IDS=
# Vercel Cron (SPEC §18.2): daily nasiya catch-up at 10:00 Tashkent. Vercel sends it as a Bearer token. Empty = off.
CRON_SECRET=
# Webhook mode (Vercel): shared secret Telegram sends with every update. Empty = webhook endpoint off (polling).
TELEGRAM_WEBHOOK_SECRET=
# Mini App: https URL of the admin panel; empty = no "Panelni ochish" button and the bot menu button is left alone
WEBAPP_URL=
# Mini App login: how old (seconds) Telegram initData may be before POST /api/auth/telegram refuses it
TELEGRAM_INITDATA_MAX_AGE=86400
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

TZ_NAME=Asia/Tashkent
APP_ENV=production
# Public domain for Caddy (use :80 for plain HTTP on an IP)
DOMAIN=:80

# Host ports. The server keeps 80/443 (Caddy needs them for HTTPS).
# On a dev machine shared with other projects, pick free ones, e.g. 23080/23443.
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
DB_PORT=23432
# Without a domain: the bot reads the current quick-tunnel hostname here for its "📱 Panel" button
TUNNEL_METRICS_URL=
